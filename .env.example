# Public base URL of the web app, encoded into the pairing QR code.
# Defaults to the current origin, which is correct in production and on a LAN.
# Set this when serving through a tunnel (cloudflared, ngrok).
VITE_PUBLIC_WEB_URL=

# Public WebSocket URL of the realtime relay.
# Defaults to wss://<current-host>:8080 on an HTTPS page.
VITE_PUBLIC_WS_URL=

# Realtime server
PORT=8080
HOST=0.0.0.0

# Optional TLS for the relay. When unset it serves ws:// and is expected to sit
# behind a TLS terminator.
TLS_KEY_PATH=
TLS_CERT_PATH=
